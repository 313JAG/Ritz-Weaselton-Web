{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": {
    "api/search-jobs.js": { "maxDuration": 60 },
    "api/search-job.js": { "maxDuration": 10 },
    "api/retry-failed.js": { "maxDuration": 60 }
  },
  "rewrites": [
    {
      "source": "/api/search-jobs/:id/retry-failed",
      "destination": "/api/retry-failed?id=:id"
    },
    {
      "source": "/api/search-jobs/:id",
      "destination": "/api/search-job?id=:id"
    },
    {
      "source": "/settings",
      "destination": "/"
    },
    {
      "source": "/settings.html",
      "destination": "/"
    },
    {
      "source": "/logos.html",
      "destination": "/"
    },
    {
      "source": "/:path*",
      "destination": "/"
    }
  ]
}
